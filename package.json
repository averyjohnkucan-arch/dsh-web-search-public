{
  "name": "@averyjohnkucan-arch/dsh-web-search-public",
  "version": "0.2.3",
  "description": "Public multi-engine search and direct HTTP fetching for DSH; explicitly selects both providers and disables DeepSeek web backends.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "THIRD-PARTY-NOTICES.md",
    "docs",
    "UPSTREAM_README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:real": "vitest run --config vitest.real.config.ts",
    "lint:package": "publint",
    "prepack": "npm run clean && npm run build",
    "check:dsh": "node scripts/check-dsh-compatibility.mjs"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/averyjohnkucan-arch/dsh-web-search-public.git"
  },
  "homepage": "https://github.com/averyjohnkucan-arch/dsh-web-search-public#readme",
  "bugs": {
    "url": "https://github.com/averyjohnkucan-arch/dsh-web-search-public/issues"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek",
    "agent",
    "harness",
    "dsh-plugin",
    "web-search",
    "search"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "effect": "4.0.0-rc.118"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-web": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-web": "0.2.1-rc.2",
    "@types/node": "24.12.4",
    "publint": "0.3.21",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "@deepseek-ai/cordis-plugin-include": "~1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "js-yaml": "^4.3.2",
    "@types/js-yaml": "^4.0.9"
  },
  "private": true
}
